OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_COACH_MODEL=deepseek/deepseek-v4-pro-0813
OPENROUTER_REVIEWER_MODEL=deepseek/deepseek-v4-flash-0731

# Необязательно: internal integration с доступом только к странице/базе Wellness.
# При непустом токене notion в servers.config.ts автоматически включается.
NOTION_TOKEN=

# RAG: OpenAI-compatible embeddings endpoint; OpenRouter использует ключ выше.
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# EMBEDDING_API_KEY=...  # для другого endpoint; иначе OPENROUTER_API_KEY
# Модель должна возвращать 1536 измерений, как в docs/001_create_knowledge_chunks.sql.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=
# Legacy backend-ключ также поддерживается вместо SUPABASE_SECRET_KEY:
# SUPABASE_SERVICE_ROLE_KEY=...
